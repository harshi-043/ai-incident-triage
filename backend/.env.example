# Copy this file to ".env" in the backend folder. Every value is optional: the app runs without any of them.
# Never commit your real ".env". Put real keys only in your own environment.

# --- Optional AI provider (OFF by default) -----------------------------------
# Choices: none | anthropic | openai | openai_compatible
AI_PROVIDER=none
# AI_MODEL=your-model-name
# AI_API_KEY=your-key-goes-here
# Only for openai_compatible (for example a local server):
# AI_BASE_URL=http://localhost:1234/v1

# --- Search method for runbooks ------------------------------------------------
# tfidf always works. sentence_transformers needs: pip install sentence-transformers (and a model download).
EMBEDDING_BACKEND=tfidf

# --- Other settings ----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
